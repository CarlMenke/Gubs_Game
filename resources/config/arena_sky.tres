[gd_resource type="Sky" load_steps=3 format=3 uid="uid://ct8gubarenasky"]

; The sky for Whisperbloom Hollow. All tuning lives here, not in the shader —
; `enchanted_sky.gdshader` only declares the knobs and their fallbacks.
;
; INCREMENTAL process mode: the sky animates, but a cloud wisp takes ~90 s to
; cross the dome, so rebuilding one radiance mip per frame is invisible and
; costs a fraction of REALTIME. 256 px radiance is plenty for a sky with no
; sharp features other than a small moon.

[ext_resource type="Shader" path="res://resources/shaders/enchanted_sky.gdshader" id="1_sky_shader"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_arena_sky"]
shader = ExtResource("1_sky_shader")
shader_parameter/zenith_color = Color(0.1, 0.09, 0.22, 1)
shader_parameter/horizon_color = Color(0.11, 0.26, 0.23, 1)
shader_parameter/void_color = Color(0.03, 0.035, 0.06, 1)
shader_parameter/horizon_falloff = 0.62
shader_parameter/void_falloff = 0.42
shader_parameter/sky_energy = 1.0
shader_parameter/forest_glow_color = Color(0.62, 0.34, 0.13, 1)
shader_parameter/forest_glow_energy = 0.42
shader_parameter/forest_glow_band = 0.13
shader_parameter/star_color = Color(0.85, 0.9, 1.0, 1)
shader_parameter/star_energy = 2.2
shader_parameter/star_density = 96.0
shader_parameter/star_coverage = 0.11
shader_parameter/star_twinkle = 0.45
shader_parameter/star_twinkle_speed = 1.3
shader_parameter/star_band_axis = Vector3(0.36, 0.62, -0.7)
shader_parameter/star_band_width = 0.34
shader_parameter/star_haze_color = Color(0.22, 0.26, 0.45, 1)
shader_parameter/star_haze_energy = 0.18
shader_parameter/moon_direction = Vector3(-0.42, 0.38, -0.82)
shader_parameter/moon_follow_light = true
shader_parameter/moon_color = Color(0.85, 0.9, 1.0, 1)
shader_parameter/moon_energy = 5.5
shader_parameter/moon_angular_size = 0.038
shader_parameter/moon_phase = 0.52
shader_parameter/moon_mare = 0.35
shader_parameter/moon_halo_color = Color(0.35, 0.45, 0.72, 1)
shader_parameter/moon_halo_energy = 0.45
shader_parameter/moon_halo_falloff = 70.0
shader_parameter/aurora_low_color = Color(0.16, 0.62, 0.45, 1)
shader_parameter/aurora_high_color = Color(0.34, 0.26, 0.62, 1)
shader_parameter/aurora_energy = 0.28
shader_parameter/aurora_height = 0.22
shader_parameter/aurora_width = 0.085
shader_parameter/aurora_speed = 0.035
shader_parameter/aurora_azimuth = -1.15
shader_parameter/aurora_spread = 3.2
shader_parameter/aurora_curtain = 0.55
shader_parameter/cloud_color = Color(0.1, 0.11, 0.17, 1)
shader_parameter/cloud_lit_color = Color(0.52, 0.56, 0.72, 1)
