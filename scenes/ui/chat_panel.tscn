[gd_scene load_steps=2 format=3 uid="uid://bgubchatpanel01"]

[ext_resource type="Script" path="res://scripts/ui/chat_panel.gd" id="1_script"]

[node name="ChatPanel" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1_script")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="HBoxContainer" parent="Body"]
unique_name_in_owner = true
layout_mode = 2

[node name="Title" type="Label" parent="Body/Heading"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "CHAT"

[node name="Log" type="RichTextLabel" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
autowrap_mode = 2

[node name="Hint" type="Label" parent="Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"TinyLabel"
text = "T to chat"

[node name="Input" type="LineEdit" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
max_length = 160
placeholder_text = "Say something"
caret_blink = true
