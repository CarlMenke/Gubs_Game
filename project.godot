[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="projectile"
3d_physics/layer_4="deployable"
3d_physics/layer_5="ragdoll"
3d_physics/layer_6="trigger"
3d_physics/layer_7="camera_blocker"
3d_render/layer_1="default"
3d_render/layer_2="nameplates"
3d_render/layer_3="first_person_only"

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60
3d/solver/solver_iterations=12

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
; Required to export for Apple Silicon: Godot refuses a universal or arm64 macOS
; build without it, because those targets have no S3TC/BPTC hardware. It costs
; import time and cache size on every texture and nothing at runtime on desktop,
; which is the right trade for being able to ship a build that runs natively on
; an M-series Mac rather than under Rosetta.
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=0
environment/defaults/default_clear_color=Color(0.0235294, 0.0313726, 0.0470588, 1)
environment/defaults/default_environment="res://resources/config/default_env.tres"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
global_illumination/gi/use_half_resolution=true
occlusion_culling/use_occlusion_culling=true
