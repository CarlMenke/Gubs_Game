; Engine configuration file.
; Generated for GUB — see docs/PLAN.md

config_version=5

[application]

config/name="GUB"
config/description="A match-based multiplayer game about small yellow aliens and thrown spears."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.04, 0.06, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://resources/config/default_bus_layout.tres"

[autoload]

Settings="*res://scripts/util/settings.gd"
Net="*res://scripts/net/net.gd"
MatchState="*res://scripts/game/match_state.gd"
SceneFlow="*res://scripts/util/scene_flow.gd"
AudioDirector="*res://scripts/util/audio_director.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file=""

