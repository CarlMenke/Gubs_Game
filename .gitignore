# Godot 4
.godot/
/android/
*.translation

# export_presets.cfg is deliberately NOT ignored, though Godot's own template
# ignores it. It carries no credentials here — code signing is off and the
# remote-deploy block is stock — and it is the only record of what a shippable
# build actually excludes (tools/, assets/, docs/). Ignoring it would mean
# "there is an export preset" was a claim nobody else could check out.
# If signing is ever enabled, move the certificate path into a local override
# rather than committing it.

# Build output
build/
*.exe
*.pck
*.zip
!assets/**/*.zip

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python tooling
__pycache__/
*.pyc
.venv/

# Scratch
scratch/
*.log

# Redundant source-art formats (the glTF copies are what the game imports).
# Kept on disk, kept out of the repo to hold clone size down.
assets/Stylized_Nature_MegaKitStandard/FBX/
assets/Stylized_Nature_MegaKitStandard/FBX (Unity)/
assets/Stylized_Nature_MegaKitStandard/OBJ/
assets/Stylized_Nature_MegaKitStandard/Textures/
assets/source/Mushroom/base.obj
desktop.ini
